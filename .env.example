# Copy to .env and change SECRET_KEY before using outside a local demo.
APP_NAME=ASTRA HEALTH
SECRET_KEY=replace-this-with-a-long-random-secret
# Default is SQLite demo mode so the project runs immediately.
# For MySQL, use: mysql+pymysql://username:password@localhost:3306/astra_health?charset=utf8mb4
DATABASE_URL=sqlite:///./astra_health.db
COOKIE_SECURE=false
